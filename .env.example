# このファイルを .env にコピーして、= の右に値を書く（cp .env.example .env）。
# 値は .env にだけ書く。このファイル（.env.example）は git に入るので、値を書かない。
# .env は git に入らない（.gitignore）。Claude Code からは .claude/settings.json の deny ルールで読めないようにしてある。
# 値に引用符は要らない。行頭 # はコメント。

# OpenAlex（無料。https://openalex.org/settings/api で取得）
OPENALEX_API_KEY=

# OpenAI Decisions API
OPENAI_API_KEY=

# Semantic Scholar（任意。無くても動くが、あると制限が緩い）
SEMANTIC_SCHOLAR_API_KEY=
